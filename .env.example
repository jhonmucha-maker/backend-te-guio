# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/db_te_guio

# JWT
JWT_SECRET=tu_jwt_secret_seguro
JWT_REFRESH_SECRET=tu_jwt_refresh_secret_seguro
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=7d

# Servidor
PORT=4002
BACKEND_URL=http://localhost:4002
FRONTEND_URL=http://localhost:5182
FRONTEND_WEB_URL=http://localhost:3070
