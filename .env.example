TZ=America/Lima

# SMTP (opcional - sin estas variables los emails se imprimen en consola)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM="Marketplace" <noreply@marketplace.pe>
